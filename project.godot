; Engine configuration file.
; 《山河剑行》 vertical slice — Godot 4.7.2, Mobile renderer.
config_version=5

[filesystem]

; 第八轮：本服务器 headless import 会被"Blender path invalid"中断，
; 工程只用 glb 不用 .blend，关闭 blender 导入器以让新贴图正常导入。
import/blender/enabled=false

[application]

config/name="山河剑行"
config/description="HD-2.5D wuxia vertical slice：村口 · 山门 · 竹林"
config/version="0.4.0"
config/icon="res://assets/branding/icon_512.png"
; 第10轮：去掉进入时的 Godot 默认启动图（导出包里那块灰底图案）。
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.05, 0.06, 1)
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

UiScale="*res://scripts/autoload/ui_scale.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
GameState="*res://scripts/autoload/game_state.gd"
DialogueDB="*res://scripts/autoload/dialogue_db.gd"
EncounterDB="*res://scripts/autoload/encounter_db.gd"
NpcDB="*res://scripts/autoload/npc_db.gd"
HiddenQuestDB="*res://scripts/autoload/hidden_quest_db.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
; 第10轮：桌面调试时鼠标会同时派发 mouse 和 touch，摇杆/按钮双触发。
input_devices/pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[gui]

theme/custom_font="res://assets/fonts/shanhe_serif.otf"
theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
scaling_3d/scale=0.75
environment/defaults/default_clear_color=Color(0.86, 0.9, 0.93, 1)
